# sqlwb-web site config. Copy to your own file (for example mysite.env) and keep it out of git.
# Used by docker compose (as .env) and by scripts/deploy.sh. Format: KEY=value, no quotes, no spaces around "=".

# --- Container (deploy.sh / compose) ---
# Image to run. From GitHub: ghcr.io/<owner>/sqlwb-web:<tag>. Local build: sqlwb-web:local
SQLWB_IMAGE=ghcr.io/OWNER/sqlwb-web:latest
SQLWB_NAME=sqlwb-web
SQLWB_PORT=8484
# Docker volume with users, workspaces and saved profiles
SQLWB_VOLUME=sqlwb-data
CPUS=2
MEM=3g
# Optional: DNS search domain, so short DB host names resolve in the container
DNS_SEARCH=

# --- App ---
# Default connection of a new tab
DEFAULT_NAME=local
DEFAULT_URL=jdbc:oracle:thin:@//db.example.com:1521/SERVICE
# App users who may install engine updates (comma list). Empty = nobody
ADMIN_USERS=
# true: the first login with a new name creates the user. false: only existing users
SIGNUP=true
# Regex of JDBC URLs users may open. Empty = jdbc:(oracle|postgresql):.*
# Do not allow embedded drivers (h2, derby, hsqldb) on a shared server: they can run code in the container.
JDBC_URL_ALLOW=
